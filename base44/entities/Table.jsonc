{
  "name": "Table",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "capacity": {
      "type": "number",
      "default": 2
    },
    "shape": {
      "type": "string",
      "enum": [
        "circle",
        "rect",
        "booth",
        "bar"
      ],
      "default": "circle"
    },
    "x": {
      "type": "number"
    },
    "y": {
      "type": "number"
    },
    "width": {
      "type": "number",
      "default": 80
    },
    "height": {
      "type": "number",
      "default": 80
    },
    "zone": {
      "type": "string",
      "enum": [
        "window",
        "booth",
        "center",
        "bar",
        "patio"
      ],
      "default": "center"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "booked"
      ],
      "default": "available"
    }
  },
  "required": [
    "name",
    "capacity",
    "shape",
    "x",
    "y",
    "zone"
  ]
}